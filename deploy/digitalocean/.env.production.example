# Copy this file to .env.production on the Droplet and fill in real values.

MAIN_URL=https://my.soposty.com
FRONTEND_URL=https://my.soposty.com
NEXT_PUBLIC_BACKEND_URL=https://my.soposty.com/api
BACKEND_INTERNAL_URL=http://localhost:3000
IS_GENERAL=true
DISABLE_REGISTRATION=false

JWT_SECRET=replace-with-a-long-random-secret

POSTGRES_USER=soposty-user
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_DB=soposty-db
DATABASE_URL=postgresql://soposty-user:replace-with-a-strong-postgres-password@soposty-postgres:5432/soposty-db
REDIS_URL=redis://soposty-redis:6379
TEMPORAL_ADDRESS=temporal:7233

STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=/uploads
NEXT_PUBLIC_UPLOAD_DIRECTORY=/uploads

# Recommended for production uploads instead of local disk.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKETNAME=
CLOUDFLARE_BUCKET_URL=
CLOUDFLARE_REGION=auto

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_SCOPES=pages_show_list,pages_read_engagement

X_URL=
X_API_KEY=
X_API_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BEEHIIVE_API_KEY=
BEEHIIVE_PUBLICATION_ID=
